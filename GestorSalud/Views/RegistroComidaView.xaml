<Window x:Class="GestorSalud.Views.RegistroComidaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🍎 Registro de Comidas" Height="520" Width="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#f0f4f8">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- Formulario -->
        <Border Background="White" CornerRadius="10" Padding="20"
                BorderBrush="#dde4eb" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📝 Registrar comida" FontSize="16" FontWeight="SemiBold"
                           Foreground="#2c3e50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tipo:" FontWeight="Medium" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbTipoComida" Grid.Column="1" Height="30" SelectedIndex="0">
                        <ComboBoxItem Content="Desayuno"/>
                        <ComboBoxItem Content="Almuerzo"/>
                        <ComboBoxItem Content="Cena"/>
                        <ComboBoxItem Content="Snack"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Comida:" FontWeight="Medium" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtAlimentos" Grid.Column="1" Height="40" Padding="5" TextWrapping="Wrap"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Calorías:" FontWeight="Medium" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtCalorias" Grid.Column="1" Height="30" Padding="5" Text="0"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Notas:" FontWeight="Medium" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtNotas" Grid.Column="1" Height="40" Padding="5" TextWrapping="Wrap"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button x:Name="btnGuardar" Content="💾 Guardar" Background="#27ae60" Foreground="White"
                            Width="90" Height="32" FontWeight="Bold" Click="BtnGuardar_Click"/>
                    <Button x:Name="btnEditar" Content="✏️ Editar" Background="#3498db" Foreground="White"
                            Width="90" Height="32" Margin="8,0,0,0" FontWeight="Bold"
                            Click="BtnEditar_Click" IsEnabled="False"/>
                    <Button x:Name="btnEliminar" Content="🗑️ Eliminar" Background="#e74c3c" Foreground="White"
                            Width="90" Height="32" Margin="8,0,0,0" FontWeight="Bold"
                            Click="BtnEliminar_Click" IsEnabled="False"/>
                </StackPanel>

                <Button Content="Cerrar" Background="#bdc3c7" Foreground="#2c3e50"
                        Height="30" Margin="0,12,0,0" Click="Cerrar_Click"/>
            </StackPanel>
        </Border>

        <!-- Separador -->
        <Rectangle Grid.Column="1" Fill="#e1e8ed" Margin="0,30,0,30"/>

        <!-- Lista -->
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15"
                BorderBrush="#dde4eb" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Tus comidas hoy" FontWeight="SemiBold" FontSize="13"
                           Margin="0,0,0,10" Foreground="#2c3e50"/>
                <ListBox x:Name="lstComidasHoy" BorderThickness="0" Background="Transparent"
                         SelectionChanged="LstComidasHoy_SelectionChanged" MaxHeight="400">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="{Binding TipoComida}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Alimentos}" FontSize="11" Foreground="#555"/>
                                <TextBlock Text="{Binding Calorias, StringFormat={}{0} kcal}" 
                                           FontSize="10" Foreground="#e67e22"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>