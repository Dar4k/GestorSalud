<Window x:Class="GestorSalud.Views.EjerciciosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorSalud.Views"
        mc:Ignorable="d"
        Title="Ejercicios Recomendados" Height="500" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#dce1e7" BorderThickness="1">
            <StackPanel>

                
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="💪"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Ejercicios Recomendados para Tu Salud"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#34495e"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Basados en tu índice de masa corporal (IMC)"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="#7f8c8d"/>
                </StackPanel>

                
                <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" 
                        Margin="0,0,0,20" Background="#f8f9fa">
                    <ListView x:Name="lvEjercicios" 
                              Height="250" 
                              FontSize="11"
                              Background="White"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ejercicio" 
                                                DisplayMemberBinding="{Binding EjercicioRecomendado}" 
                                                Width="220"/>
                                <GridViewColumn Header="Clasificación IMC" 
                                                DisplayMemberBinding="{Binding ClasificacionImc}" 
                                                Width="150"/>
                                <GridViewColumn Header="Intensidad" 
                                                DisplayMemberBinding="{Binding Intensidad}" 
                                                Width="100"/>
                                <GridViewColumn Header="Duración (min)" 
                                                DisplayMemberBinding="{Binding DuracionSugerida}" 
                                                Width="90"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="📄 Descargar PDF"
                            Width="130"
                            Height="35"
                            Margin="10,0"
                            Padding="8"
                            Background="#27ae60"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderBrush="Transparent"
                            Click="DescargarPDF_Click"/>

                    <Button Content="← Volver"
                            Width="100"
                            Height="35"
                            Margin="10,0"
                            Padding="8"
                            Background="#2980b9"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderBrush="Transparent"
                            Click="Volver_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>