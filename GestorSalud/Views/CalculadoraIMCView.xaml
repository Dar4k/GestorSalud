<Window x:Class="GestorSalud.Views.CalculadoraIMCView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorSalud.Views"
        mc:Ignorable="d"
        Title="Calculadora" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Height="496" Width="713">
    <Grid Background="#f8f9fa" Margin="20">
        <Border Background="White" CornerRadius="10" Padding="25" 
                BorderBrush="#ddd" BorderThickness="1" Height="460" VerticalAlignment="Center">
            <StackPanel>
                
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="⚖️" FontSize="30" HorizontalAlignment="Center"/>
                    <TextBlock Text="CALCULADORA IMC" FontSize="18" FontWeight="Bold" 
                              Foreground="#333" HorizontalAlignment="Center"/>
                    <TextBlock Text="Índice de Masa Corporal" FontSize="12" 
                              Foreground="#666" HorizontalAlignment="Center"/>
                </StackPanel>

                
                <Label Content="Peso (kg):" FontWeight="Bold"/>
                <TextBox x:Name="txtPeso" Height="35" FontSize="14" 
                        Text="70" TextAlignment="Center"/>

                <Label Content="Altura (metros):" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBox x:Name="txtAltura" Height="35" FontSize="14" 
                        Text="1.75" TextAlignment="Center"/>

                
                <Button Content="🎯 CALCULAR IMC" Background="#e67e22" 
                        Foreground="White" FontWeight="Bold" Height="35" 
                        FontSize="13" Margin="0,15,0,10" Click="Calcular_Click"/>

                
                <Border Background="#ecf0f1" CornerRadius="8" Padding="15" 
                        Margin="0,10,0,0" Visibility="Collapsed" x:Name="borderResultado">
                    <StackPanel>
                        <TextBlock x:Name="txtResultado" FontSize="16" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Foreground="#2c3e50"/>
                        <TextBlock x:Name="txtClasificacion" FontSize="14" 
                                  HorizontalAlignment="Center" Margin="0,5,0,0"/>

                        
                        <Border Height="15" Background="#bdc3c7" CornerRadius="7" 
                                Margin="0,10,0,5">
                            <Border x:Name="barraProgreso" Height="15" 
                                   Background="#27ae60" CornerRadius="7" 
                                   HorizontalAlignment="Left" Width="0"/>
                        </Border>

                        <TextBlock x:Name="txtRecomendacion" FontSize="12" 
                                  TextWrapping="Wrap" HorizontalAlignment="Center" 
                                  Margin="0,10,0,0" Foreground="#7f8c8d"/>
                    </StackPanel>
                </Border>

                
                <Button Content="CERRAR" Background="#95a5a6" Foreground="White" 
                        Height="35" Margin="0,15,0,0" Click="Cerrar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>