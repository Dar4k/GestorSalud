<Window x:Class="GestorSalud.Views.HistorialPesoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Peso" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Background="#f8f9fa" Margin="15">
        <Border Background="White" CornerRadius="10" Padding="20" 
                BorderBrush="#ddd" BorderThickness="1">
            <StackPanel>
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="HISTORIAL DE PESO" FontSize="18" FontWeight="Bold" 
                              Foreground="#333" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtResumen" FontSize="12" Foreground="#666" 
                              HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Controles -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Button Content="🔄 Actualizar" Background="#3498db" 
                            Foreground="White" FontWeight="Bold" Height="30" 
                            Width="100" Margin="5,0" Click="ActualizarHistorial_Click"/>
                    <Button Content="📄 Exportar PDF" Background="#e74c3c" 
                            Foreground="White" FontWeight="Bold" Height="30" 
                            Width="110" Margin="5,0" Click="ExportarPDFHistorial_Click"/>
                    <Button Content="❌ Cerrar" Background="#95a5a6" 
                            Foreground="White" Height="30" 
                            Width="80" Margin="5,0" Click="CerrarHistorial_Click"/>
                </StackPanel>

                <!-- DataGrid -->
                <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5">
                    <DataGrid x:Name="dgHistorialPeso" AutoGenerateColumns="False" 
                             IsReadOnly="True" HeadersVisibility="Column"
                             CanUserAddRows="False" CanUserDeleteRows="False"
                             Height="350" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Peso (kg)" Binding="{Binding Peso, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Altura (m)" Binding="{Binding Altura, StringFormat=F2}" Width="80"/>
                            <DataGridTextColumn Header="IMC" Binding="{Binding IMCCalculado, StringFormat=F1}" Width="70"/>
                            <DataGridTextColumn Header="Clasificación" Binding="{Binding ClasificacionIMC}" Width="180"/>
                            <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Estadísticas -->
                <Border Background="#ecf0f1" CornerRadius="8" Padding="15" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="📈 ESTADÍSTICAS" FontWeight="Bold" FontSize="13" 
                                  Foreground="#2c3e50" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Border Background="#e8f5e8" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Peso Inicial" FontSize="10" Foreground="#666"/>
                                    <TextBlock x:Name="txtPesoInicialHistorial" FontSize="12" FontWeight="Bold" Foreground="#27ae60"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#e3f2fd" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Peso Actual" FontSize="10" Foreground="#666"/>
                                    <TextBlock x:Name="txtPesoActualHistorial" FontSize="12" FontWeight="Bold" Foreground="#2196f3"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#fff3e0" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Diferencia" FontSize="10" Foreground="#666"/>
                                    <TextBlock x:Name="txtDiferenciaHistorial" FontSize="12" FontWeight="Bold" Foreground="#ff9800"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#fce4ec" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Total Registros" FontSize="10" Foreground="#666"/>
                                    <TextBlock x:Name="txtTotalRegistrosHistorial" FontSize="12" FontWeight="Bold" Foreground="#e91e63"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>