<Window x:Class="GestorSalud.Views.RegistroPesoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="Registrar Peso" Height="550" Width="450" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" MaxHeight="600" MaxWidth="500">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#f8f9fa" Margin="15">
        <Border Background="White" CornerRadius="10" Padding="20" 
                BorderBrush="#ddd" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                         MaxHeight="500"
                         Padding="0" Margin="0">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="⚖️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="REGISTRAR PESO" FontSize="16" FontWeight="Bold" 
                                  Foreground="#333" HorizontalAlignment="Center"/>
                        <TextBlock Text="Registra tu peso y altura para calcular IMC" 
                                  FontSize="11" Foreground="#666" HorizontalAlignment="Center"
                                  TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                    </StackPanel>

                    <!-- Campos de registro -->
                    <StackPanel Margin="0,10,0,0">

                        <!-- Peso -->
                        <Label Content="Peso (kg):"/>
                        <TextBox x:Name="txtPeso" Height="35" 
                                TextAlignment="Center" Text="66"
                                ToolTip="Ingresa tu peso en kilogramos"/>

                        <!-- Altura -->
                        <Label Content="Altura (metros):"/>
                        <TextBox x:Name="txtAltura" Height="35" 
                                TextAlignment="Center" Text="1.70"
                                ToolTip="Ingresa tu altura en metros (ej: 1.70)"/>

                        <!-- Fecha -->
                        <Label Content="Fecha de registro:"/>
                        <DatePicker x:Name="dpFechaRegistro" Height="35" 
                                   SelectedDate="{x:Static system:DateTime.Today}"
                                   FontSize="13"/>

                        <!-- Notas -->
                        <Label Content="Notas (opcional):"/>
                        <TextBox x:Name="txtNotas" Height="50" 
                                TextWrapping="Wrap" AcceptsReturn="True" 
                                VerticalScrollBarVisibility="Auto"
                                ToolTip="Observaciones sobre tu peso"/>
                    </StackPanel>

                    <!-- Información IMC -->
                    <Border Background="#ecf0f1" CornerRadius="8" Padding="12" 
                            Margin="0,15,0,10" x:Name="borderIMC" 
                            Visibility="Collapsed" MaxWidth="350">
                        <StackPanel>
                            <TextBlock x:Name="txtIMCResultado" FontSize="13" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Foreground="#2c3e50"
                                      TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtClasificacion" FontSize="11" 
                                      HorizontalAlignment="Center" Margin="0,3,0,0"
                                      TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="💾 GUARDAR" Background="#27ae60" 
                                Foreground="White" FontWeight="Bold" Height="35" 
                                Width="110" Margin="5,0" Click="Guardar_Click"
                                FontSize="12"/>
                        <Button Content="📊 CALCULAR IMC" Background="#3498db" 
                                Foreground="White" FontWeight="Bold" Height="35" 
                                Width="120" Margin="5,0" Click="CalcularIMC_Click"
                                FontSize="12"/>
                        <Button Content="❌ CERRAR" Background="#95a5a6" 
                                Foreground="White" Height="35" 
                                Width="80" Margin="5,0" Click="Cerrar_Click"
                                FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>